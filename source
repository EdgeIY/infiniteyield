group{
	name = "jobid",
	description = "Copies a link that joins this exact server to your clipboard.",
	requires = { capability = "setclipboard" },
	run = function(ctx)
		Env.fn.setclipboard(ServerInfo.joinLink())
		ctx:notify("Clipboard", "Copied to clipboard")
