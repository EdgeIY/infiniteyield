	All of the state is in features/performance and features/prompts; the bugs
	each one fixes are listed in those headers.
═══════════════════════════════════════════════════════════════════════════]]

local IY = ...
local Cmd         = IY.import("cmd/api")
local Env         = IY.import("core/env")
