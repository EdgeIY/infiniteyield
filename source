	name = "freeze",
	aliases = { "fr" },
	description = "Anchors a player where they stand.",
	args = { { name = "players", type = "players", optional = true } },
	examples = { "freeze bob", "thaw bob" },
	toggle = false,
	offAliases = { "thaw", "unfr" },
	run = function(ctx)
