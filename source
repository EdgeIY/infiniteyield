-- ── notifications ───────────────────────────────────────────────────────────

group{
	name = "volume",
	aliases = { "vol" },
	description = "Sets your game volume, on a scale of 0 to 10.",
	args = { { name = "level", type = "number", min = 0, max = 10 } },
	examples = { "volume 0", "vol 7" },
